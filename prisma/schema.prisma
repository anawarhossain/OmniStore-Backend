generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User{
  id String @id @default(uuid())
  name String
  email String @unique
  age Int
  createdAt DateTime @default(now())
}

model Product{
  id String @id @default(uuid())
  title String
  price Float
  createdAt DateTime @default(now())
}